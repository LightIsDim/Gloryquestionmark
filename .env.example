# ============================================================
# FILECORE
# ============================================================

# Absolute path recommended in production.
STORAGE_PATH=/storage

# Human-readable configuration.
MAX_FILE_SIZE=10GB

# Upload chunk size.
# 16 MB is a reasonable default.
UPLOAD_CHUNK_SIZE=16777216

# ------------------------------------------------------------
# Authentication
# ------------------------------------------------------------
# Strongly recommended for anything exposed to a network.
#
APP_USER=admin
APP_PASSWORD=wut?